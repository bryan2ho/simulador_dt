void partida(Club *mi_club, int opcion_principal) {

    do{
        mostrar_menu_principal(mi_club->nombre_equipo, mi_club->dia_actual, mi_club->presupuesto);
        scanf("%d", &opcion_principal);

        switch(opcion_principal) {
            case 1:
                limpiar_pantalla();
                mostrar_plantilla(mi_club);
                enter_continuar();
                break;
            case 2:
                mercado();
                enter_continuar();
                break;
            case 3:
                limpiar_pantalla();
               
                printf("Avanzando al siguiente dia...\n");
                enter_continuar();

                if(mi_club->dia_actual < 7){
                    eventos_ejecutar(&mi_club);
                }else{
                    eventos_final(&mi_club);
                }
                mi_club->dia_actual++;
                break;
            case 4:
                guardar_partida(mi_club);
                enter_continuar();
                limpiar_pantalla();
                break;
            case 6:
                printf("Regresando al menu principal...\n");
                break;
            default:
                printf("Opcion invalida. Por favor, elige una opcion valida.\n");
                break;
        }

        if(mi_club->dia_actual < 7){}
    } while(mi_club->dia_actual <= 7 && opcion_principal != 6);
}


int main(){

    Club mi_club;
    int opcion_inicial, opcion_principal;


do{
    mostrar_menu_inicial();
    scanf("%d", &opcion_inicial);

    switch(opcion_inicial) {
        case 1:
            printf("=========================================\n");
            printf("Ingresa el nombre de tu club: ");
            scanf("%s", mi_club.nombre_equipo);
            printf("=========================================\n");

            inicializar_club(&mi_club);

            partida(&mi_club, 0);
            limpiar_pantalla();
            break;
        case 2:
            cargar_partida(&mi_club);
            partida(&mi_club, 0);
            break;
        case 3:
            mostrar_creditos();

            break;
        case 4:
            printf("Saliendo del juego...\n");
            break;
        default:
            printf("Opcion inválida. Por favor, elige una opción válida.\n");
            break;
    }
}while(opcion_inicial != 4);

free(mi_club.plantilla);
mi_club.plantilla = NULL;
mi_club.total_jugadores = 0;
return 0;
}
